<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Arc?>

<StackPane fx:id="scanRoot" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.kentom.devcleaner.ScanController">

    <!-- Initial Scan State -->
    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <VBox fx:id="scanBox" styleClass="scan-container" style="-fx-padding: 0 20;">
            <Label styleClass="view-title" text="Scan for Projects"/>
            <Label styleClass="view-subtitle" wrapText="true" textAlignment="CENTER"
                   text="Select a folder to scan. DevCleaner will search for projects and calculate cleanable space."/>

            <VBox styleClass="scan-input-section" spacing="25">
                <HBox alignment="CENTER" spacing="12.0" styleClass="input-group">
                    <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                        <Image url="@icons/folder.png"/>
                    </ImageView>
                    <TextField fx:id="directoryPathField" promptText="Enter directory path..." HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleBrowseAction" styleClass="browse-button" text="Browse"/>
                </HBox>

                <Button fx:id="scanButton" onAction="#handleScanAction" styleClass="scan-button" text="Start Scanning">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <Image url="@icons/scan.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>

            <!-- Tips Section -->
            <VBox styleClass="scan-tips-section" spacing="15" alignment="CENTER">
                <Label styleClass="tips-title" text="Scanning Tips"/>
                <VBox spacing="12" alignment="CENTER_LEFT">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <Image url="@icons/info.png"/>
                        </ImageView>
                        <Label styleClass="tip-text" text="Scan common development directories like ~/Projects or ~/Documents"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <Image url="@icons/info.png"/>
                        </ImageView>
                        <Label styleClass="tip-text" text="Larger directories may take several minutes to scan"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <Image url="@icons/info.png"/>
                        </ImageView>
                        <Label styleClass="tip-text" text="DevCleaner detects Node.js, Rust, Go, and other project types"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Enhanced Scanning In Progress State -->
    <ScrollPane fx:id="scanningBox" fitToWidth="true" styleClass="scroll-pane" visible="false">
        <VBox styleClass="scanning-container" spacing="30">

            <!-- Header Section -->
            <VBox alignment="CENTER" spacing="15" styleClass="scanning-header">
                <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                    <Image url="@icons/Insider-loading.gif"/>
                </ImageView>
                <Label styleClass="scanning-title" text="Scanning in Progress"/>
                <Label fx:id="scanPhaseLabel" styleClass="scanning-phase" text="Initializing..."/>
            </VBox>

            <!-- Progress Section -->
            <VBox spacing="20" styleClass="progress-section">

                <!-- Main Progress Bar -->
                <VBox spacing="8" alignment="CENTER">
                    <HBox spacing="10" alignment="CENTER">
                        <Label fx:id="progressPercentageLabel" styleClass="progress-percentage" text="0%"/>
                        <Label fx:id="progressETALabel" styleClass="progress-eta" text="Estimating..."/>
                    </HBox>
                    <javafx.scene.control.ProgressBar fx:id="scanProgressBar" styleClass="main-progress-bar" prefWidth="400" progress="0"/>
                </VBox>

                <!-- Current Scanning Info -->
                <VBox spacing="12" styleClass="current-scan-info">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <Image url="@icons/folder.png"/>
                        </ImageView>
                        <Label styleClass="scan-info-label" text="Current Folder:"/>
                        <Label fx:id="currentFolderLabel" styleClass="scan-info-value" text="/" wrapText="true"/>
                    </HBox>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <Image url="@icons/scan.png"/>
                        </ImageView>
                        <Label styleClass="scan-info-label" text="Processing:"/>
                        <Label fx:id="currentFileLabel" styleClass="scan-info-value" text="Preparing scan..."/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Statistics Grid -->
            <HBox spacing="30" alignment="CENTER" styleClass="stats-grid">

                <!-- Left Column -->
                <VBox spacing="15" alignment="CENTER" styleClass="stats-column">
                    <Label styleClass="stats-column-title" text="Scan Progress"/>

                    <VBox spacing="8" alignment="CENTER">
                        <Label fx:id="directoriesScannedLabel" styleClass="stat-number" text="0"/>
                        <Label styleClass="stat-label" text="Directories Scanned"/>
                    </VBox>

                    <VBox spacing="8" alignment="CENTER">
                        <Label fx:id="filesScannedLabel" styleClass="stat-number" text="0"/>
                        <Label styleClass="stat-label" text="Files Processed"/>
                    </VBox>

                    <VBox spacing="8" alignment="CENTER">
                        <Label fx:id="scanSpeedLabel" styleClass="stat-number" text="0/s"/>
                        <Label styleClass="stat-label" text="Scan Speed"/>
                    </VBox>
                </VBox>

                <!-- Right Column -->
                <VBox spacing="15" alignment="CENTER" styleClass="stats-column">
                    <Label styleClass="stats-column-title" text="Projects Found"/>

                    <VBox spacing="8" alignment="CENTER">
                        <Label fx:id="projectsFoundLabel" styleClass="stat-number highlight" text="0"/>
                        <Label styleClass="stat-label" text="Projects Discovered"/>
                    </VBox>

                    <VBox spacing="8" alignment="CENTER">
                        <Label fx:id="cleanableSpaceLabel" styleClass="stat-number highlight" text="0 B"/>
                        <Label styleClass="stat-label" text="Cleanable Space"/>
                    </VBox>

                    <VBox spacing="8" alignment="CENTER">
                        <Label fx:id="totalDataLabel" styleClass="stat-number" text="0 B"/>
                        <Label styleClass="stat-label" text="Data Processed"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Recent Discoveries -->
            <VBox fx:id="recentDiscoveriesSection" spacing="15" styleClass="recent-discoveries" visible="false" managed="false">
                <Label styleClass="section-title" text="Recent Discoveries"/>
                <VBox fx:id="recentProjectsList" spacing="8" styleClass="recent-projects-list"/>
            </VBox>

            <!-- Project Types Breakdown -->
            <VBox fx:id="projectTypesSection" spacing="15" styleClass="project-types" visible="false" managed="false">
                <Label styleClass="section-title" text="Project Types Found"/>
                <HBox fx:id="projectTypesList" spacing="12" alignment="CENTER" styleClass="project-types-list"/>
            </VBox>

            <!-- Control Buttons -->
            <HBox spacing="15" alignment="CENTER" styleClass="scan-controls">
                <Button fx:id="pauseButton" styleClass="control-button secondary" text="Pause" onAction="#handlePauseAction" visible="false" managed="false"/>
                <Button fx:id="cancelButton" styleClass="control-button danger" text="Cancel Scan" onAction="#handleCancelAction"/>
            </HBox>

            <!-- Performance Info (Small Footer) -->
            <VBox spacing="5" alignment="CENTER" styleClass="performance-info">
                <HBox spacing="20" alignment="CENTER">
                    <Label fx:id="elapsedTimeLabel" styleClass="performance-stat" text="Elapsed: 0s"/>
                    <Label fx:id="errorsCountLabel" styleClass="performance-stat" text="Errors: 0"/>
                </HBox>
                <VBox fx:id="recentErrorsSection" spacing="5" visible="false" managed="false">
                    <Label styleClass="errors-title" text="Recent Issues:"/>
                    <VBox fx:id="recentErrorsList" spacing="3" styleClass="recent-errors-list"/>
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>

</StackPane>