<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.kentom</groupId>
    <artifactId>dev_cleaner</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Dev Cleaner</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <javafx.version>21</javafx.version>
        <main.class>com.kentom.devcleaner.DevCleanerApp</main.class>
        <java.home>/Users/user/Library/Java/JavaVirtualMachines/openjdk-23.0.2/Contents/Home</java.home>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.controlsfx</groupId>
            <artifactId>controlsfx</artifactId>
            <version>11.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.dlsc.formsfx</groupId>
            <artifactId>formsfx-core</artifactId>
            <version>11.6.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.bootstrapfx</groupId>
            <artifactId>bootstrapfx-core</artifactId>
            <version>0.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>

            <!-- Create executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>${main.class}</mainClass>
                                </manifest>
                            </archive>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                            <appendAssemblyId>false</appendAssemblyId>
                            <finalName>${project.artifactId}-${project.version}</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build native package with jpackage -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jlink-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <launcher>devcleaner=com.kentom.devcleaner.DevCleanerApp</launcher>
<!--                    <jlinkZipPath>${project.build.directory}/runtime.zip</jlinkZipPath>-->
<!--                    <jlinkImageName>runtime</jlinkImageName>-->
                    <noManPages>true</noManPages>
                    <stripDebug>true</stripDebug>
                    <compress>2</compress>
                    <modulePaths>
                        <modulePath>${project.build.directory}/modules</modulePath>
                    </modulePaths>
                    <addModules>
                        <addModule>javafx.controls</addModule>
                        <addModule>javafx.fxml</addModule>
                        <addModule>java.logging</addModule>
                    </addModules>
                </configuration>
                <!-- Commented out executions to avoid jlink issues with automatic modules -->
                <!--
                <executions>
                    <execution>
                        <id>create-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jlink</goal>
                        </goals>
                    </execution>
                </executions>
                -->
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.kentom.devcleaner.DevCleanerApp</mainClass>
                    <commandlineArgs>--add-opens java.base/java.lang=ALL-UNNAMED</commandlineArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>jlink</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jlink</goal>
                        </goals>
                        <configuration>
                            <launcher>devcleaner</launcher>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Update jpackage plugin to use custom runtime -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <toolhome>${java.home}</toolhome>
                    <name>Dev Cleaner Pro</name>
                    <appVersion>1.0.1</appVersion>
                    <vendor>kenTom</vendor>
                    <copyright>Copyright © 2023 kenTom</copyright>
                    <mainClass>${main.class}</mainClass>
                    <mainJar>${project.artifactId}-${project.version}.jar</mainJar>
                    <input>${project.build.directory}</input>
                    <destination>${project.build.directory}/jpackage</destination>

                    <!-- Use JavaFX jlink runtime -->
                    <runtimeImage>${project.build.directory}/image</runtimeImage>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- macOS Profile -->
        <profile>
            <id>macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <icon>src/main/resources/com/kentom/devcleaner/icons/app-icon.icns</icon>
                            <resourceDir>src/main/deploy/package/macos</resourceDir>
                            <packageType>dmg</packageType>
                            <macPackageIdentifier>com.kentom.devcleaner</macPackageIdentifier>
                            <macPackageName>Dev Cleaner Pro</macPackageName>
                            <macSign>false</macSign>
                            <macBundleSigningPrefix></macBundleSigningPrefix>
                            <javaOptions>
                                <javaOption>-Dapple.awt.UIElement=true</javaOption>
                            </javaOptions>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Windows Profile -->
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <icon>src/main/resources/com/kentom/devcleaner/icons/app-icon.ico</icon>
                            <resourceDir>src/main/deploy/package/windows</resourceDir>
                            <packageType>msi</packageType>
                            <winDirChooser>true</winDirChooser>
                            <winMenu>true</winMenu>
                            <winMenuGroup>kenTom</winMenuGroup>
                            <winShortcut>true</winShortcut>
                            <winPerUserInstall>false</winPerUserInstall>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Linux Profile -->
        <profile>
            <id>linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>!Mac OS X</name>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <icon>src/main/resources/com/kentom/devcleaner/icons/logo-512x512.png</icon>
                            <resourceDir>src/main/deploy/package/linux</resourceDir>
                            <packageType>deb</packageType>
                            <linuxPackageName>dev-cleaner-pro</linuxPackageName>
                            <linuxDebMaintainer>kenTom &lt;kentom@example.com&gt;</linuxDebMaintainer>
                            <linuxMenuGroup>Development</linuxMenuGroup>
                            <linuxShortcut>true</linuxShortcut>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>