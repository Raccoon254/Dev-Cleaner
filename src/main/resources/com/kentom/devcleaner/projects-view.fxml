<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="projectsRoot" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.kentom.devcleaner.ProjectsController">
    <VBox alignment="TOP_CENTER" spacing="20.0">
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox styleClass="projects-container" style="-fx-padding: 0 20;">
                <!-- Projects Header -->
                <VBox styleClass="projects-header" spacing="24">
                    <!-- Title Section -->
                    <VBox styleClass="header-title-section" spacing="8">
                        <Label styleClass="view-title" text="Projects"/>
                        <Label styleClass="view-subtitle" wrapText="true"
                               text="Manage your development projects. Click any project to view details and clean up generated files."/>
                    </VBox>
                    
                    <!-- Stats and Controls Section -->
                    <VBox fx:id="projectStatsBox" styleClass="header-stats-container" spacing="20" visible="false">
                        <!-- Project Stats Row -->
                        <HBox styleClass="stats-row" spacing="30" alignment="CENTER_LEFT">
                            <VBox styleClass="header-stat-item" spacing="4">
                                <Label styleClass="stat-number" fx:id="totalProjectsLabel" text="0"/>
                                <Label styleClass="stat-label" text="Projects"/>
                            </VBox>
                            <VBox styleClass="header-stat-item" spacing="4">
                                <Label styleClass="stat-number" fx:id="totalCleanableLabel" text="0 GB"/>
                                <Label styleClass="stat-label" text="Cleanable Size"/>
                            </VBox>
                            <VBox styleClass="header-stat-item" spacing="4">
                                <Label styleClass="stat-number" fx:id="projectTypesLabel" text="0"/>
                                <Label styleClass="stat-label" text="Project Types"/>
                            </VBox>
                        </HBox>
                        
                        <!-- Sort Controls Row -->
                        <HBox styleClass="sort-controls-row" spacing="12" alignment="CENTER_LEFT">
                            <Label text="Sort by:" styleClass="sort-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button fx:id="sortNameBtn" onAction="#sortByName" styleClass="sort-button" text="Name">
                                    <graphic>
                                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                            <Image url="@icons/sort-by-alphabet.png"/>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="sortSizeBtn" onAction="#sortBySize" styleClass="sort-button" text="Size">
                                    <graphic>
                                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                            <Image url="@icons/sort-by-size.png"/>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="sortDateBtn" onAction="#sortByDate" styleClass="sort-button" text="Date">
                                    <graphic>
                                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                            <Image url="@icons/sort-by-time.png"/>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="sortTypeBtn" onAction="#sortByType" styleClass="sort-button" text="Type">
                                    <graphic>
                                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                            <Image url="@icons/terminal.png"/>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </HBox>
                        </HBox>
                    </VBox>
                </VBox>
                
                <TilePane style="-fx-padding: 20px 0" fx:id="projectTilePane" hgap="20" vgap="20" 
                         prefColumns="-1" prefRows="-1" tileAlignment="CENTER"/>
            </VBox>
        </ScrollPane>

        <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="15" VBox.vgrow="ALWAYS" visible="false">
            <SVGPath styleClass="empty-state-icon"
                     content="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M11,15.5L9.5,14.25L7.25,16.5L9.5,18.75L11,17.5L9.75,16.5L11,15.5M16.75,16.5L14.5,18.75L13,17.5L14.25,16.5L13,15.5L14.5,14.25L16.75,16.5Z"/>
            <Label styleClass="empty-state-title" text="No Projects Found"/>
            <Label styleClass="empty-state-text"
                   text="Use the 'Scan' tab to find development projects on your system."/>
        </VBox>
    </VBox>
</StackPane>