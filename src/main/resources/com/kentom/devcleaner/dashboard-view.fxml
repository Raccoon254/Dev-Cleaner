<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane fx:id="dashboardRoot" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.kentom.devcleaner.DashboardController">
    
    <!-- Loading State -->
    <VBox fx:id="loadingStateBox" alignment="CENTER" spacing="20" visible="false">
        <VBox alignment="CENTER" spacing="15" styleClass="loading-container">
            <ImageView fitHeight="48" fitWidth="48" preserveRatio="true">
                <Image url="@icons/Insider-loading.gif"/>
            </ImageView>
            <VBox alignment="CENTER" spacing="8">
                <Label styleClass="loading-title" text="Loading Dashboard"/>
                <Label fx:id="loadingStatusLabel" styleClass="loading-status" text="Analyzing project statistics..."/>
            </VBox>
        </VBox>
    </VBox>
    
    <!-- Main Content -->
    <VBox fx:id="mainContentBox" spacing="20.0">
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox styleClass="dashboard-container" spacing="30">
                
                <!-- Dashboard Header -->
                <VBox styleClass="dashboard-header" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <ImageView fitHeight="32" fitWidth="32" preserveRatio="true" styleClass="dashboard-icon">
                            <Image url="@icons/dashboard.png"/>
                        </ImageView>
                        <VBox spacing="2">
                            <Label styleClass="dashboard-title" text="DevCleaner Dashboard"/>
                            <Label styleClass="dashboard-subtitle" fx:id="lastUpdatedLabel" text="Last updated: Now"/>
                        </VBox>
                    </HBox>
                </VBox>
                
                <!-- Primary Stats Row -->
                <GridPane styleClass="stats-grid" hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                    </columnConstraints>
                    
                    <!-- Total Projects Card -->
                    <VBox styleClass="primary-stat-card" spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <ImageView fitHeight="24" fitWidth="24" preserveRatio="true" styleClass="stat-icon">
                                <Image url="@icons/box.png"/>
                            </ImageView>
                            <VBox spacing="2">
                                <Label styleClass="stat-title" text="Total Projects"/>
                                <Label fx:id="projectCountLabel" styleClass="primary-stat-value" text="0"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="projectTrendLabel" styleClass="stat-trend" text=""/>
                    </VBox>
                    
                    <!-- Disk Usage Card -->
                    <VBox styleClass="primary-stat-card" spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <ImageView fitHeight="24" fitWidth="24" preserveRatio="true" styleClass="stat-icon">
                                <Image url="@icons/disk.png"/>
                            </ImageView>
                            <VBox spacing="2">
                                <Label styleClass="stat-title" text="Total Usage"/>
                                <Label fx:id="diskUsageLabel" styleClass="primary-stat-value" text="N/A"/>
                            </VBox>
                        </HBox>
                        <ProgressBar fx:id="diskUsageProgress" styleClass="usage-progress" prefWidth="200" progress="0"/>
                    </VBox>
                    
                    <!-- Cleanable Space Card -->
                    <VBox styleClass="primary-stat-card" spacing="15" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <ImageView fitHeight="24" fitWidth="24" preserveRatio="true" styleClass="stat-icon">
                                <Image url="@icons/trash.png"/>
                            </ImageView>
                            <VBox spacing="2">
                                <Label styleClass="stat-title" text="Cleanable"/>
                                <Label fx:id="cleanableSpaceLabel" styleClass="primary-stat-value" text="0 GB"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="potentialSavingsLabel" styleClass="stat-savings" text="Potential savings"/>
                    </VBox>
                    
                    <!-- Git Projects Card -->
                    <VBox styleClass="primary-stat-card" spacing="15" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <ImageView fitHeight="24" fitWidth="24" preserveRatio="true" styleClass="stat-icon">
                                <Image url="@icons/github.png"/>
                            </ImageView>
                            <VBox spacing="2">
                                <Label styleClass="stat-title" text="Git Repos"/>
                                <Label fx:id="gitProjectsLabel" styleClass="primary-stat-value" text="0"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="gitPercentageLabel" styleClass="stat-percentage" text="0% of projects"/>
                    </VBox>
                </GridPane>
                
                <!-- Secondary Stats Row -->
                <HBox spacing="20" styleClass="secondary-stats">
                    <!-- Project Types Breakdown -->
                    <VBox styleClass="secondary-stat-card" spacing="15" HBox.hgrow="ALWAYS">
                        <Label styleClass="secondary-stat-title" text="Project Types"/>
                        <VBox fx:id="projectTypesBreakdown" spacing="8"/>
                    </VBox>
                    
                    <!-- Largest Projects -->
                    <VBox styleClass="secondary-stat-card" spacing="15" HBox.hgrow="ALWAYS">
                        <Label styleClass="secondary-stat-title" text="Storage Hogs"/>
                        <VBox fx:id="largestProjectsList" spacing="8"/>
                    </VBox>
                    
                    <!-- Quick Actions -->
                    <VBox styleClass="secondary-stat-card action-card" spacing="15" HBox.hgrow="ALWAYS">
                        <Label styleClass="secondary-stat-title" text="Quick Actions"/>
                        <VBox spacing="10">
                            <HBox styleClass="quick-action" spacing="10" alignment="CENTER_LEFT">
                                <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                    <Image url="@icons/scan.png"/>
                                </ImageView>
                                <Label styleClass="action-text" text="Scan for new projects"/>
                            </HBox>
                            <HBox styleClass="quick-action" spacing="10" alignment="CENTER_LEFT">
                                <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                    <Image url="@icons/clean.png"/>
                                </ImageView>
                                <Label styleClass="action-text" text="Clean all projects"/>
                            </HBox>
                            <HBox styleClass="quick-action" spacing="10" alignment="CENTER_LEFT">
                                <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                    <Image url="@icons/settings.png"/>
                                </ImageView>
                                <Label styleClass="action-text" text="Configure settings"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>
                
                <!-- Charts and Analytics Section -->
                <GridPane styleClass="analytics-grid" hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    </columnConstraints>
                    
                    <!-- Recent Activity -->
                    <VBox styleClass="analytics-card" spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                <Image url="@icons/activity.png"/>
                            </ImageView>
                            <Label styleClass="analytics-title" text="Recent Activity"/>
                        </HBox>
                        <ScrollPane styleClass="activity-scroll" prefHeight="200" fitToWidth="true">
                            <VBox fx:id="recentActivityBox" styleClass="activity-container" spacing="8"/>
                        </ScrollPane>
                    </VBox>
                    
                    <!-- System Health -->
                    <VBox styleClass="analytics-card" spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                <Image url="@icons/health.png"/>
                            </ImageView>
                            <Label styleClass="analytics-title" text="System Health"/>
                        </HBox>
                        <VBox spacing="12">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label styleClass="health-metric" text="Cache Status"/>
                                <Label fx:id="cacheStatusLabel" styleClass="health-value good" text="Healthy"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label styleClass="health-metric" text="Last Scan"/>
                                <Label fx:id="lastScanLabel" styleClass="health-value" text="Never"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label styleClass="health-metric" text="Performance"/>
                                <Label fx:id="performanceLabel" styleClass="health-value good" text="Optimal"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </GridPane>
                
            </VBox>
        </ScrollPane>
    </VBox>
    
</StackPane>