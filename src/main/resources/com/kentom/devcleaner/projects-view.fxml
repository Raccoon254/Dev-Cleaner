<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="projectsRoot" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.kentom.devcleaner.ProjectsController">
    <VBox alignment="TOP_CENTER" spacing="20.0">
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox styleClass="projects-container">
                <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 20;">
                    <Label styleClass="view-title" text="Projects" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="resetButton" onAction="#handleResetProjects" styleClass="reset-button" text="Reset All" visible="false">
                        <graphic>
                            <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                <Image url="@icons/reset.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
                <TilePane style="-fx-padding: 20px" fx:id="projectTilePane" hgap="20" vgap="20"/>
            </VBox>
        </ScrollPane>

        <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="15" VBox.vgrow="ALWAYS" visible="false">
            <SVGPath styleClass="empty-state-icon"
                     content="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M11,15.5L9.5,14.25L7.25,16.5L9.5,18.75L11,17.5L9.75,16.5L11,15.5M16.75,16.5L14.5,18.75L13,17.5L14.25,16.5L13,15.5L14.5,14.25L16.75,16.5Z"/>
            <Label styleClass="empty-state-title" text="No Projects Found"/>
            <Label styleClass="empty-state-text"
                   text="Use the 'Scan' tab to find development projects on your system."/>
        </VBox>
    </VBox>
</StackPane>