<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.Image?>

<VBox fx:id="splashRoot" styleClass="splash-container" alignment="CENTER" spacing="30" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kentom.devcleaner.SplashController">
    <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0"/>
    </padding>

    <!-- App Logo/Icon -->
    <ImageView fx:id="appIcon" fitHeight="120" fitWidth="120" preserveRatio="true">
        <Image url="@icons/app-icon.png"/>
    </ImageView>

    <!-- App Info -->
    <VBox alignment="CENTER" spacing="8">
        <Label styleClass="splash-title" text="DevCleaner"/>
        <Label styleClass="splash-subtitle" text="Clean up your development projects"/>
        <Label styleClass="splash-version" fx:id="versionLabel" text="v1.0"/>
    </VBox>

    <!-- Loading Section -->
    <VBox alignment="CENTER" spacing="12">
        <Label styleClass="splash-loading-text" fx:id="loadingLabel" text="Initializing..."/>
        <ProgressBar fx:id="progressBar" styleClass="splash-progress" prefWidth="250" progress="0"/>
    </VBox>

    <!-- Footer -->
    <VBox alignment="CENTER" spacing="4" style="-fx-padding: 20 0 0 0;">
        <Label styleClass="splash-footer" text="Loading your projects..."/>
        <HBox alignment="CENTER" spacing="4">
            <Label styleClass="splash-footer-small" text="Powered by"/>
            <Label styleClass="splash-footer-brand" text="JavaFX"/>
        </HBox>
    </VBox>
</VBox>