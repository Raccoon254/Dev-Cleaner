<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Arc?>

<StackPane fx:id="scanRoot" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.kentom.devcleaner.ScanController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <!-- Initial Scan State -->
    <VBox fx:id="scanBox" alignment="CENTER" spacing="25.0" maxWidth="600">
        <Label styleClass="view-title" text="Scan for Projects"/>
        <Label styleClass="view-subtitle" wrapText="true" textAlignment="CENTER"
               text="Select a folder to scan. DevCleaner will search for projects and calculate cleanable space."/>

        <HBox alignment="CENTER" spacing="10.0">
            <TextField fx:id="directoryPathField" promptText="Enter directory path..." HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleBrowseAction" styleClass="button-outline" text="Browse..."/>
        </HBox>

        <Button fx:id="scanButton" onAction="#handleScanAction" styleClass="scan-button" text="Scan Now">
            <graphic>
                <SVGPath content="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
            </graphic>
        </Button>
    </VBox>

    <!-- Scanning In Progress State -->
    <VBox fx:id="scanningBox" alignment="CENTER" spacing="20.0" visible="false">
        <StackPane fx:id="loadingAnimation" styleClass="loader">
            <Arc type="OPEN" startAngle="0" length="120" styleClass="loader-arc" />
            <Arc type="OPEN" startAngle="150" length="120" styleClass="loader-arc" />
        </StackPane>
        <Label styleClass="scan-status-title" text="Scanning in Progress..."/>
        <Label fx:id="scanStatusLabel" styleClass="scan-status-text" text="Initializing..."/>
    </VBox>

</StackPane>